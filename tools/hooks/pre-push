#!/bin/bash
# ============================================
# 推送前安全审查门禁（pre-push hook）
# 拦截：API 密钥 / 私钥文件 / GitHub 令牌 / AWS 密钥 /
#       本机绝对路径 / 会话 ID / 敏感文件类型
# 绕过方式：git push --no-verify（不建议）
# ============================================
ZERO="0000000000000000000000000000000000000000"

# 高信号密钥模式（避免误伤英语词库中的普通单词，如 secretary/password）
PATTERNS='-----BEGIN [A-Z ]*PRIVATE KEY-----|ghp_[A-Za-z0-9]{20,}|github_pat_[A-Za-z0-9_]{20,}|AKIA[0-9A-Z]{16}|xox[baprs]-[A-Za-z0-9-]{10,}|sk-[A-Za-z0-9]{20,}|"(password|secret|api_key|apikey|access_token|private_key)"\s*:\s*"[^"]{8,}"|Bearer\s+[A-Za-z0-9._-]{25,}'
# 本机隐私路径 / 会话标识
PATH_PATTERNS='C:[/\\]+Users[/\\][^/"]+|/home/[a-z][a-z0-9_]+/|\.zcode|sess_[A-Za-z0-9]{8,}'
# 危险文件类型
SENSITIVE_FILES='\.env$|\.pem$|\.p12$|\.pfx$|id_rsa|id_ed25519|credentials?\.json|\.sqlite3?$|\.db$'

fail=0
while read -r local_ref local_sha remote_ref remote_sha; do
  # 分支删除（本地为 0）无需扫描
  [ "$local_sha" = "$ZERO" ] && continue

  range=""
  if [ "$remote_sha" = "$ZERO" ]; then
    range="$local_sha"          # 新分支：只扫新 tip 树
  else
    range="$remote_sha..$local_sha"
  fi

  # 1) 扫描本次推送涉及的提交内容（含新增提交的完整补丁，能抓到"加了又删"的密钥）
  hits=$(git log -p "$range" 2>/dev/null | grep -a -n -E -e "$PATTERNS" | head -5)
  if [ -n "$hits" ]; then
    echo ""
    echo "❌ [安全门禁] 疑似密钥/令牌泄露，推送被拦截："
    echo "$hits" | cut -c1-200
    echo "   处理：删除敏感内容后重新提交；历史泄露需改写历史（git filter-repo）。"
    echo "   确认为误报时可用 git push --no-verify 跳过一次。"
    fail=1
  fi

  # 2) 扫描新 tip 树中的本机路径 / 会话 ID
  path_hits=$(git grep -I -n -E "$PATH_PATTERNS" "$local_sha" -- . 2>/dev/null | head -5)
  if [ -n "$path_hits" ]; then
    echo ""
    echo "❌ [安全门禁] 发现本机路径/会话标识泄露，推送被拦截："
    echo "$path_hits" | cut -c1-200
    fail=1
  fi

  # 3) 检查是否提交了敏感类型文件
  bad_files=$(git ls-tree -r --name-only "$local_sha" | grep -i -E "$SENSITIVE_FILES" | head -5)
  if [ -n "$bad_files" ]; then
    echo ""
    echo "❌ [安全门禁] 发现敏感类型文件，推送被拦截："
    echo "$bad_files"
    echo "   如确需提交，请先移出仓库或加入 .gitignore。"
    fail=1
  fi
done

if [ "$fail" = "1" ]; then
  echo ""
  echo "🛡️  推送已中止 —— 修正上述问题后重试。"
  exit 1
fi
exit 0
